{
  "productName": "TheDesk",
  "appId": "next.top.thedesk",
  "files": [
    "main-build",
    "renderer/out",
    "!node_modules/electron-native-auth/build/Release/electron_native_auth.node.dSYM"
  ],
  "mas": {
    "type": "distribution",
    "entitlements": "build/parent.plist",
    "entitlementsInherit": "build/child.plist",
    "entitlementsLoginHelper": "build/loginhelper.plist",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "extendInfo": {
      "ITSAppUsesNonExemptEncryption": "false"
    },
    "provisioningProfile": "build/TheDesk_Prod.provisionprofile",
    "minimumSystemVersion": "14.0"
  },
  "mac": {
    "icon": "assets/icon.icns",
    "target": [
      "mas"
    ],
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "singleArchFiles": "*",
    "notarize": false,
    "category": "public.app-category.social-networking",
    "mergeASARs": true,
    "x64ArchFiles": "*"
  }
}
